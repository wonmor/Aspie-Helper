{
  "cli": {
    "version": ">= 5.2.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "ios": {
        "image": "latest"
      },
      "android": {
        "image": "latest"
      }
    },
    "simulator": {
      "extends": "production",
      "ios": {
        "simulator": true,
        "image": "latest"
      },
      "distribution": "internal"
    },
    "screenshots": {
      "extends": "production",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_DEMO_OFFERS": "1"
      },
      "ios": {
        "simulator": true,
        "image": "latest"
      },
      "android": {
        "buildType": "apk",
        "image": "latest"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6466399113",
        "appleTeamId": "Z64KRUX3W3"
      },
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
